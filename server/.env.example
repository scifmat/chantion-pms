# 复制本文件为 .env 后按需修改；不要把服务器 IP 或路径写死在代码里
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/chantion.db
BACKUP_DIR=/mnt/backup-disk/chantion
TZ=Asia/Shanghai
LOG_LEVEL=info
# JWT 签名密钥：生产环境务必改成随机长字符串，改后所有用户需重新登录
JWT_SECRET=chantion-pms-dev-secret-change-me-in-production
# 首次启动生成的默认管理员（已存在则忽略，改过的密码不会被覆盖）
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
